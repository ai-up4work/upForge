# ── Database (same MongoDB as the original Up4Work site) ──
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ── Images (same Cloudinary account) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder for all site media. Keep the original so existing images keep working.
CLOUDINARY_ROOT_FOLDER=Up4work-portfolio
# Optional: limit the public Gallery page to one folder (default = everything under the root, like the old site)
# GALLERY_FOLDER=Up4work-portfolio/gallery

# ── Admin ──
PAGE_ACCESS_PASSWORD=choose-a-long-password
# Signs admin sessions. Use a long random string: openssl rand -base64 32
SESSION_SECRET=

# ── Site ──
NEXT_PUBLIC_BASE_URL=https://www.up4work.space
# Optional: Formspree (or similar) endpoint so the contact form sends email
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxx

# ── Local SEO (recommended; must match your Google Business Profile exactly) ──
# NEXT_PUBLIC_PHONE=+94 77 123 4567
# NEXT_PUBLIC_STREET=No. 1, Example Road, Colombo 03

# ── Search engine verification ──
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
